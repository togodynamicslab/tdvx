# Copie para .env e preencha com os valores reais
# cp .env.example .env

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=           # gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── VM com GPU ────────────────────────────────────────────────────────────────
TDVX_VM_HOST=           # IP ou hostname da VM (ex: 192.168.1.100)
TDVX_VM_USER=root
TDVX_VM_KEY_PATH=/keys/vm_key        # chave SSH montada no container

# ── Common Voice Download ─────────────────────────────────────────────────────
TDVX_CV_TOKEN=200b0ff9a75977f821683b7ce76bdc8ccfd48477daa93228ff045f35e4d9214f

# ── MLflow (opcional) ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
