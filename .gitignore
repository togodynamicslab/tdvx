web/node_modules/
web/dist/

# Vite-built static SPA bundle — regenerated by `npm run build`
static/dist/

# Python build artifacts
*.pyc

# But explicitly allow:
#   tests/corpus/**/.reference/*.json  — Deepgram ground-truth references
#   tests/corpus/**/.validations.json  — human judgments
# (nothing ignores them above, so no !include line needed)
