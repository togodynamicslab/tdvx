# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — raiz do projeto voice_model
# ─────────────────────────────────────────────────────────────────────────────

# ── Ambientes virtuais ────────────────────────────────────────────────────────
venv/
venv_cpu/
venv_gpu/
.venv/
.venv-finetune/
env/
ENV/
env.bak/
venv.bak/

# ── Logs de instalação pip ────────────────────────────────────────────────────
[0-9]*.[0-9]*.[0-9]

# ── Variáveis de ambiente — NUNCA commitar ────────────────────────────────────
.env

# ── Modelos locais (muito grandes para versionar) ─────────────────────────────
models/
model/
.cache/
*.pt
*.bin
*.safetensors
*.tar.gz

# ── Resultados de avaliação gerados ──────────────────────────────────────────
eval/results/
eval/audio/

# ── Saídas do pipeline e gravações ───────────────────────────────────────────
*.json
*.wav
*.mp3
*.flac
*.ogg
!.gitignore

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
cvss/
*.egg-info/
.installed.cfg
*.egg

# ── Uploads e temporários ─────────────────────────────────────────────────────
temp/
uploads/
test_results/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.jsonl
finetuning_data/

# ── MLflow — tracking de experimentos ────────────────────────────────────────
mlruns/                  # runs locais (SQLite backend)
mlartifacts/             # artefatos locais
mlflow.db                # banco SQLite local (dev)
.mlflow/

