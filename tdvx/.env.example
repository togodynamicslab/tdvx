# ═════════════════════════════════════════════════════════════════════════════
# TDvX — Variáveis de Ambiente
# ═════════════════════════════════════════════════════════════════════════════
#
# Copie este arquivo para .env e preencha os valores necessários:
#   cp .env.example .env
#
# Nunca commite o arquivo .env (ele deve estar no .gitignore)
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Pyannote (Diarização de falantes)
# ─────────────────────────────────────────────────────────────────────────────
# Obtenha seu token em: https://huggingface.co/settings/tokens
# Aceite os termos em: https://huggingface.co/pyannote/speaker-diarization-3.1

PYANNOTE_AUTH_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# MLflow Tracking Server
# ─────────────────────────────────────────────────────────────────────────────
# URI do servidor MLflow para rastreamento de experimentos de fine-tuning
# Local:     http://localhost:5000
# Container: http://mlflow:5000
# Remoto:    http://seu-servidor-mlflow.com:5000

MLFLOW_TRACKING_URI=http://localhost:5000

# Nome do experimento padrão para fine-tuning
MLFLOW_FINETUNE_EXPERIMENT=tdv1-finetune

# Senha do banco de dados PostgreSQL do MLflow
# (usada internamente pelo docker-compose)
MLFLOW_DB_PASSWORD=mlflow123


# ─────────────────────────────────────────────────────────────────────────────
# pgAdmin (Interface web para PostgreSQL - opcional)
# ─────────────────────────────────────────────────────────────────────────────
# Acesse em: http://localhost:5050
# Para iniciar: docker-compose --profile tools up -d pgadmin

PGADMIN_EMAIL=admin@tdvx.local
PGADMIN_PASSWORD=admin123


# ─────────────────────────────────────────────────────────────────────────────
# HuggingFace Hub (Publicação de modelos fine-tunados - opcional)
# ─────────────────────────────────────────────────────────────────────────────
# Token com permissão de escrita para publicar modelos fine-tunados
# Obtenha em: https://huggingface.co/settings/tokens

HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# TDvX API (Configurações do serviço de transcrição)
# ─────────────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8000

# Modelo padrão: tdv1-fast, tdv1-balanced, tdv1
DEFAULT_MODEL=tdv1-fast

# Features habilitadas
ENABLE_DIARIZATION=true
ENABLE_TDV1=true
ENABLE_TDV1_BALANCED=true
ENABLE_TDV1_FAST=true

# Configurações de processamento
CHUNK_DURATION_SECONDS=10.0

# Diarização (Pyannote)
PYANNOTE_MIN_SPEAKERS=1
PYANNOTE_MAX_SPEAKERS=10
PYANNOTE_CLUSTERING_THRESHOLD=0.5
PYANNOTE_LIVE_CLUSTERING_THRESHOLD=0.65


# ─────────────────────────────────────────────────────────────────────────────
# Fine-tuning Dataset Collection (opcional)
# ─────────────────────────────────────────────────────────────────────────────
# Habilita coleta automática de dados para fine-tuning
# Os dados são salvos em ./finetuning_data/

FINETUNING_ENABLED=false
FINETUNING_MIN_CONFIDENCE=0.70
FINETUNING_SAMPLE_RATE=0.05


# ─────────────────────────────────────────────────────────────────────────────
# Logging & Debugging
# ─────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
