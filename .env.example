# Copie para .env e preencha os valores
# cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# HuggingFace — necessário para baixar CORAA, LaPS BM e Common Voice
# Gere em: https://huggingface.co/settings/tokens
# ─────────────────────────────────────────────────────────────────────────────
HF_TOKEN=hf_...
HUGGING_FACE_HUB_TOKEN=hf_...
PYANNOTE_AUTH_TOKEN=hf_...

# ─────────────────────────────────────────────────────────────────────────────
# MLflow (opcional — deixe vazio para usar armazenamento local ./mlruns)
# ─────────────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_FINETUNE_EXPERIMENT=tdvx-commonvoice
