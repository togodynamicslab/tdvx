# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variáveis de ambiente do projeto voice_model
# Copie para .env e preencha os valores antes de usar.
# ─────────────────────────────────────────────────────────────────────────────

# Hugging Face token para modelos Pyannote (obrigatório)
# Gere em: https://huggingface.co/settings/tokens
# Aceite os termos em: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here
PYANNOTE_AUTH_TOKEN=your_huggingface_token_here

# ── Servidor (tdvx) ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Pipelines Whisper (tdvx) ──────────────────────────────────────────────────
DEFAULT_MODEL=tdv1-fast

# TDv1 — alta qualidade (large-v3, ~15-20s por 10s de áudio)
ENABLE_TDV1=true
TDV1_WHISPER_MODEL=large-v3

# TDv1-Balanced — equilíbrio qualidade/velocidade (medium, ~8-12s por 10s)
ENABLE_TDV1_BALANCED=true
TDV1_BALANCED_WHISPER_MODEL=medium

# TDv1-Fast — tempo real (faster-whisper medium, ~4-6s por 10s)
ENABLE_TDV1_FAST=true
TDV1_FAST_WHISPER_MODEL=medium

# Legacy (retrocompatibilidade)
WHISPER_MODEL=medium
ENABLE_DIARIZATION=true

# ── Quantização Whisper ───────────────────────────────────────────────────────
# Opções: int8 | int8_float16 | float16 | int4
# int8_float16 recomendado para GPU | int8 recomendado para CPU
# Deixe vazio para usar o padrão automático do pipeline
WHISPER_COMPUTE_TYPE=

# ── Processamento de áudio ────────────────────────────────────────────────────
CHUNK_DURATION_SECONDS=10.0
MAX_AUDIO_FILE_SIZE_MB=100

# ── VAD (Voice Activity Detection) ───────────────────────────────────────────
ENABLE_VAD=true
VAD_AGGRESSIVENESS=1

# ── Diarização Pyannote ───────────────────────────────────────────────────────
PYANNOTE_MIN_SPEAKERS=1
PYANNOTE_MAX_SPEAKERS=10
PYANNOTE_CLUSTERING_THRESHOLD=0.5
PYANNOTE_LIVE_CLUSTERING_THRESHOLD=0.65
PYANNOTE_SEGMENTATION_ONSET=0.5

# ── MLflow — rastreamento de experimentos e Model Registry (opcional) ────────
# Instale: pip install -r requirements-finetune.txt
# Suba servidor: mlflow server --host 0.0.0.0 --port 5000
# UI disponível em: http://localhost:5000
#
# MLFLOW_TRACKING_URI: onde os dados de tracking são gravados.
#   - Servidor dedicado: http://localhost:5000
#   - Arquivo local (sem servidor): file:./mlruns
MLFLOW_TRACKING_URI=http://localhost:5000
#
# MLFLOW_FINETUNE_EXPERIMENT: experimento exclusivo do fine-tuning do modelo.
# Separa dos logs de inferência da API (MLFLOW_EXPERIMENT_NAME abaixo).
MLFLOW_FINETUNE_EXPERIMENT=tdv1-finetune
#
# MLFLOW_EXPERIMENT_NAME: experimento da API de transcrição (app/main.py).
MLFLOW_EXPERIMENT_NAME=tdvx-transcription

# ── Modo offline (após 1º download dos modelos) ───────────────────────────────
# Descomente para bloquear chamadas de rede ao HuggingFace Hub
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
